# Frontend + backend upload env vars
VITE_AWS_S3_BASE_URL=https://gypspace.s3.us-east-1.amazonaws.com
VITE_AWS_REGION=us-east-1
VITE_AWS_S3_BUCKET=gypspace
VITE_AWS_ACCESS_KEY_ID=your_access_key_here
VITE_AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Presigned URL API (if you use backend endpoint)
VITE_PRESIGNED_URL_API_URL=http://localhost:3001/api/presigned-url

# Backend server environment variables (for server/presigned-url-server.js or Lambda)
AWS_REGION=us-east-1
AWS_S3_BUCKET=gypspace
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
